# ---- Sam-DataLens environment ----
# Copy to .env.local for local dev, or set these as Vercel Project env vars.

# Groq (OpenAI-compatible) API key — powers the AI insight generation.
# Get a free key at https://console.groq.com  (no card required).
GROQ_API_KEY=

# Optional: override the Groq chat model. Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# NextAuth session secret. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the deployment (e.g. https://your-app.vercel.app).
# For local dev use http://localhost:3000
NEXTAUTH_URL=

# PostgreSQL connection string (optional).
# The app runs fully in demo mode without a real database — saved queries and
# login fall back to in-memory behaviour when this is unreachable. Leave the
# placeholder to run without provisioning any database.
DATABASE_URL=postgresql://user:password@localhost:5432/datalens
